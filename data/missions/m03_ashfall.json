    {"id": "marek", "pos": [-49.5, -37.2], "heading": -90},
    {"id": "voss",  "pos": [-46.0, -36.9], "heading": -90},
    {"id": "kell",  "pos": [-50.0, -39.0], "heading": -60, "profile": "wounded", "invulnerable": false}
  ],

  "protect": [
    {"id": "kell", "message": "Pvt. Kell didn't make it."}
  ],

  "intro": {
    "shots": [
      {"from": [-75, -78, 34], "to": [-60, -66, 22], "look_from": [0, 10, 0], "look_to": [-30, -20, 0], "duration": 6.0},
      {"from": [-44.8, -36.0, 1.9], "to": [-45.6, -37.4, 1.6], "look_from": [-50, -39, 0.9], "look_to": [-50, -39, 0.8], "duration": 7.0}
    ],
    "lines": [
      {"t": 0.4, "speaker": "narrator", "text": "Day Three. The line at Kesh broke after dark. We fell back through Veyra.", "seconds": 3.8},
      {"t": 4.3, "speaker": "narrator", "text": "Kell caught shrapnel on the edge of town.", "seconds": 2.8},
      {"t": 7.2, "speaker": "marek", "text": "Easy, Jonah. The field hospital is on the north side. We're getting you there.", "seconds": 3.4},
      {"t": 10.6, "speaker": "kell", "text": "Just... don't leave me here, alright?", "seconds": 2.6}
    ]
  },

  "outro": {
    "shots": [
      {"from": [44, 54, 2.0], "to": [30, 30, 26], "look_from": [48, 64, 1.5], "look_to": [-10, 0, 0], "duration": 12.0}
    ],
    "lines": [
      {"t": 0.3, "speaker": "lind", "text": "Shrapnel in the lung, but he's stable. He'll live.", "seconds": 3.2},
      {"t": 3.7, "speaker": "kell", "text": "Told you... nothing ever happens to me.", "seconds": 2.8},
      {"t": 6.8, "speaker": "narrator", "text": "Veyra burned for three days. Kell was on the first hospital train south.", "seconds": 3.6},
      {"t": 10.5, "speaker": "narrator", "text": "The rest of us were sent to the river.", "seconds": 2.0}
    ]
  },

